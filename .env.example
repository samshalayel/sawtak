# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Accounts registered with these emails (comma-separated) get the admin role.
ADMIN_EMAIL="admin@example.com"

# DATA_DIR: Where the SQLite database (users, credits, usage) is stored. Mount it as a volume in Docker.
DATA_DIR="./data"

# PUBLIC_URL: Public address of the site, used in verification emails and the Google redirect URI.
PUBLIC_URL="https://tts.smartcloud.ps"

# SMTP settings for sending verification emails (any provider: Gmail app password, Brevo, Zoho, hosting...).
# Without SMTP_HOST, verification links are printed to the server log instead (local development).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="app-password"
MAIL_FROM="صوتك الذكي <you@gmail.com>"

# Google sign-in (OAuth client from Google Cloud Console). The button is hidden until both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Jawwal Pay. The gateway stays off until the three credentials are set.
# JAWWAL_BASE_URL is the test environment by default; set the production address Jawwal Pay gave you to take real payments.
JAWWAL_BASE_URL="https://apitest.jawwalpay.ps"
JAWWAL_USERNAME=""
JAWWAL_PASSWORD=""
JAWWAL_HMAC_SECRET=""

# Speech from ElevenLabs instead of Gemini (leave TTS_PROVIDER out to keep Gemini). Voice ids are from the
# ElevenLabs voice library; the female / male one is used for the site's female / male voices.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=
# ELEVENLABS_VOICE_MAP={"Kore":"<voice id>"}   optional: one ElevenLabs voice per site voice
# ELEVENLABS_MODEL=eleven_multilingual_v2      or eleven_v3 (no pace control)
# ELEVENLABS_CONCURRENCY=3                     requests at once; the limit depends on the ElevenLabs plan
